{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TMFC060 Knowledge Management chart values",
  "type": "object",
  "definitions": {
    "image": {
      "type": "object",
      "required": ["image", "version"],
      "properties": {
        "image": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "prereleaseSuffix": {"type": ["string", "null"]}
      }
    },
    "url": {"type": "string", "pattern": "^https?://\\S+$"},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "dependentAPI": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "id", "specification"],
      "properties": {
        "enabled": {"type": "boolean"},
        "id": {"type": "string", "pattern": "^TMF[0-9]{3}$"},
        "description": {"type": "string"},
        "specification": {"type": "string"},
        "events": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z]+Event$"}}
      },
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {"properties": {"specification": {"$ref": "#/definitions/url"}}}
    },
    "person": {
      "type": "object",
      "required": ["name"],
      "properties": {"name": {"type": "string"}, "email": {"type": "string"}}
    }
  },
  "required": ["knowledgeApi", "pipelineWorker", "mcpServer", "component", "security", "dependentAPIs", "ports"],
  "properties": {
    "knowledgeApi": {"$ref": "#/definitions/image"},
    "pipelineWorker": {"$ref": "#/definitions/image"},
    "mcpServer": {"$ref": "#/definitions/image"},
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "functionalBlock", "version"],
      "properties": {
        "id": {"type": "string", "const": "TMFC060"},
        "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "functionalBlock": {"type": "string"},
        "publicationDate": {"type": "string"},
        "version": {"type": "string"},
        "description": {"type": "string"},
        "knowledgeApiSpecification": {"anyOf": [{"const": ""}, {"$ref": "#/definitions/url"}]},
        "processFlowApiSpecification": {"anyOf": [{"const": ""}, {"$ref": "#/definitions/url"}]},
        "mcpSpecification": {"$ref": "#/definitions/url"},
        "maintainers": {"type": "array", "items": {"$ref": "#/definitions/person"}},
        "owners": {"type": "array", "items": {"$ref": "#/definitions/person"}}
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canvasSystemRole", "componentRole"],
      "properties": {
        "canvasSystemRole": {"type": "string", "minLength": 1},
        "componentRole": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {"name": {"type": "string", "minLength": 1}, "description": {"type": "string"}}
          }
        }
      }
    },
    "dependentAPIs": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9]+$"},
      "additionalProperties": {"$ref": "#/definitions/dependentAPI"}
    },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "metrics", "mcp"],
      "properties": {
        "api": {"$ref": "#/definitions/port"},
        "metrics": {"$ref": "#/definitions/port"},
        "mcp": {"$ref": "#/definitions/port"}
      }
    }
  }
}
