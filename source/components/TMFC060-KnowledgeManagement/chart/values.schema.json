{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TMFC060 Knowledge Management chart values",
  "type": "object",
  "definitions": {
    "url": {
      "type": "string",
      "pattern": "^https?://\\S+$"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "dependentAPI": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "id",
        "specification"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "type": "string",
          "pattern": "^TMF[0-9]{3}$"
        },
        "description": {
          "type": "string"
        },
        "specification": {
          "type": "string"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z]+Event$"
          }
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "specification": {
            "$ref": "#/definitions/url"
          }
        }
      }
    },
    "person": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      }
    },
    "workload": {
      "type": "object",
      "required": [
        "image",
        "version",
        "pullPolicy",
        "resources"
      ],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "prereleaseSuffix": {
          "type": [
            "string",
            "null"
          ]
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "logLevel": {
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ]
        },
        "resources": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "shapes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/].*$"
          }
        }
      }
    }
  },
  "required": [
    "component",
    "dependentAPIs",
    "keycloak",
    "knowledgeApi",
    "mcpServer",
    "pipelineWorker",
    "ports",
    "security"
  ],
  "properties": {
    "knowledgeApi": {
      "description": "The API is a StatefulSet with exactly one replica (one writer of the pyoxigraph store), so it has no replicas value",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "version",
        "pullPolicy",
        "resources",
        "store"
      ],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "prereleaseSuffix": {
          "type": [
            "string",
            "null"
          ]
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "logLevel": {
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ]
        },
        "resources": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "store": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size"
          ],
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti)$"
            },
            "storageClass": {
              "type": "string"
            }
          }
        }
      }
    },
    "pipelineWorker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "version",
        "replicas",
        "concurrency"
      ],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "prereleaseSuffix": {
          "type": [
            "string",
            "null"
          ]
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "logLevel": {
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ]
        },
        "resources": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "mcpServer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "version",
        "replicas"
      ],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "prereleaseSuffix": {
          "type": [
            "string",
            "null"
          ]
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "logLevel": {
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ]
        },
        "resources": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "functionalBlock",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "const": "TMFC060"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "functionalBlock": {
          "type": "string"
        },
        "publicationDate": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "knowledgeApiSpecification": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "$ref": "#/definitions/url"
            }
          ]
        },
        "processFlowApiSpecification": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "$ref": "#/definitions/url"
            }
          ]
        },
        "mcpSpecification": {
          "$ref": "#/definitions/url"
        },
        "maintainers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/person"
          }
        },
        "owners": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/person"
          }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canvasSystemRole",
        "componentRole"
      ],
      "properties": {
        "canvasSystemRole": {
          "type": "string",
          "minLength": 1
        },
        "componentRole": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "dependentAPIs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/dependentAPI"
      }
    },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "metrics",
        "internal",
        "mcp",
        "workerHealth"
      ],
      "properties": {
        "api": {
          "$ref": "#/definitions/port"
        },
        "metrics": {
          "$ref": "#/definitions/port"
        },
        "internal": {
          "$ref": "#/definitions/port"
        },
        "mcp": {
          "$ref": "#/definitions/port"
        },
        "workerHealth": {
          "$ref": "#/definitions/port"
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "external": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "type": "string",
                  "pattern": "^postgres(ql)?://"
                }
              ]
            },
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "qdrant": {
      "description": "Values of the official Qdrant chart, plus enabled",
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "apiKey": {
          "description": "true (generated) is what the API reads; a string or valueFrom is not supported by this chart",
          "const": true
        }
      }
    },
    "keycloak": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseUrl",
        "realm"
      ],
      "properties": {
        "baseUrl": {
          "$ref": "#/definitions/url"
        },
        "realm": {
          "type": "string",
          "minLength": 1
        },
        "extraIssuers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/url"
          }
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agentgateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "$ref": "#/definitions/url"
                }
              ]
            },
            "chatModel": {
              "type": "string"
            },
            "embeddingModel": {
              "type": "string"
            }
          }
        },
        "openaiCompatible": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseUrl": {
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "$ref": "#/definitions/url"
                }
              ]
            },
            "chatModel": {
              "type": "string"
            },
            "embeddingModel": {
              "type": "string"
            },
            "apiKeySecret": {
              "type": "string"
            },
            "apiKeySecretKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "embeddingDimension": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "callbackBase": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "$ref": "#/definitions/url"
            }
          ]
        },
        "callbackAllowedHosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "canvasInfoUrl": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "$ref": "#/definitions/url"
            }
          ]
        },
        "hrefBase": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "$ref": "#/definitions/url"
            }
          ]
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "database",
        "username",
        "persistence"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "database": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "username": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "existingSecret": {
          "type": "string"
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size"
          ],
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti)$"
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "externalQdrant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "$ref": "#/definitions/url"
            }
          ]
        },
        "apiKeySecret": {
          "type": "string"
        },
        "apiKeySecretKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "modelResolver": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelGatewayService": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string",
              "pattern": "^$|^([a-z0-9]([-a-z0-9]*[a-z0-9])?/)?[a-z0-9]([-.a-z0-9]*[a-z0-9])?$"
            },
            "chatModel": {
              "type": "string"
            },
            "embeddingModel": {
              "type": "string"
            }
          },
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "name": {
                "minLength": 1
              },
              "chatModel": {
                "minLength": 1
              },
              "embeddingModel": {
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "dataResourceConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "providedDataResources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "providedDataResources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "engine",
              "exposedAPI",
              "mcpAPI"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "maxLength": 63
              },
              "type": {
                "enum": [
                  "vectorStore",
                  "knowledgeGraph",
                  "dataProduct",
                  "cache"
                ]
              },
              "description": {
                "type": "string"
              },
              "engine": {
                "type": "string",
                "minLength": 1
              },
              "exposedAPI": {
                "description": "An ExposedAPI of this Component that serves REST",
                "enum": [
                  "knowledgemanagement"
                ]
              },
              "mcpAPI": {
                "description": "The ExposedAPI of this Component that serves MCP",
                "enum": [
                  "knowledgemcp"
                ]
              },
              "retrieval": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "topK": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "scoreThreshold": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "hybrid": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "ontologySources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind"
        ],
        "oneOf": [
          {
            "additionalProperties": false,
            "required": [
              "name",
              "kind",
              "url"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "maxLength": 40
              },
              "kind": {
                "const": "git"
              },
              "url": {
                "type": "string",
                "pattern": "^https://\\S+$"
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "credentialSecret": {
                "type": "string",
                "pattern": "^[a-z0-9]([-.a-z0-9]*[a-z0-9])?$"
              },
              "shapes": {
                "$ref": "#/definitions/shapes"
              }
            }
          },
          {
            "additionalProperties": false,
            "required": [
              "name",
              "kind",
              "secretName"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "maxLength": 40
              },
              "kind": {
                "const": "secretMount"
              },
              "secretName": {
                "type": "string",
                "pattern": "^[a-z0-9]([-.a-z0-9]*[a-z0-9])?$"
              },
              "path": {
                "type": "string",
                "pattern": "^[^/]*$|^[^/].*[^/]$"
              },
              "shapes": {
                "$ref": "#/definitions/shapes"
              }
            }
          }
        ]
      }
    },
    "ontologySync": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intervalSeconds": {
          "type": "integer",
          "minimum": 60
        }
      }
    }
  },
  "additionalProperties": false
}
